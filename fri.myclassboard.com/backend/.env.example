# Copy to backend/.env and fill in. backend/.env is git-ignored.

# SQL Server / Azure SQL Managed Instance (read-only source)
MCB_DB_SERVER=your-instance.public.xxxx.database.windows.net
MCB_DB_PORT=3342
MCB_DB_USER=
MCB_DB_PASSWORD=''
MCB_DB_NAME=MCBMaster
MCB_DB_DRIVER=ODBC Driver 18 for SQL Server

# Tenant DBs left out of all figures (comma separated)
MCB_EXCLUDE_DBS=MKTGDEMO
# Count school-store sales as fee collections?
MCB_INCLUDE_SCHOOL_STORE=false
# Hide organisations with Active = 0 in dbo.MCBOrganisations
MCB_HIDE_INACTIVE_ORGS=true
# Months in the institute scoring window: the latest N complete months of the FY. 12 = every complete month
# (the whole financial year to date), which is what the school and Institutes pages show by default.
MCB_INSTITUTE_MONTHS=12
# Seconds to cache query results
MCB_CACHE_TTL=600

# PostgreSQL for portal-only data (owners, notes, pipeline, consent, settings, campaigns).
# Tables are created automatically in schema "portal".
MCB_APP_DB_URL=postgresql+psycopg://mcb_portal:change-me@localhost:5432/mcb_portal
# Seconds between checks for a new payments snapshot (GeneratedDate); 5 = every page load verifies against the DB
MCB_FRESHNESS_CHECK=5
# Seconds before the organisation → gateway mapping view is re-read
MCB_GATEWAY_MAP_TTL=120

# AI suggestions (Claude API)
MCB_ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (Console → Settings → Workspaces, "wrkspc_…")
MCB_ANTHROPIC_WORKSPACE_ID=
MCB_AI_MODEL=claude-opus-5-5
MCB_AI_EFFORT=medium

MCB_LOG_LEVEL=INFO

# Account owners for assignment, "ID:Name" comma separated
MCB_OWNERS=
# Account team shown against each organisation (from dbo.USP_GET_BranchAnalysis_MCBMaster). false = do not show.
MCB_ACCOUNT_TEAM=true
MCB_USER_EMAIL=

# Sign-in: Google account, allowed only for active MCBMaster staff (dbo.Users, Status = 1), as in Admin MIS.
# The site's origin must be an "Authorized JavaScript origin" of this client in Google Cloud Console.
MCB_GOOGLE_CLIENT_ID=429290070059-pk04va9e5hjpfc7feg7tsdl8k1dfr3ur.apps.googleusercontent.com
# dbo.Users.UserTypeID values allowed to sign in (comma separated)
MCB_LOGIN_USER_TYPE_IDS=1
# Long random string that signs the session cookie:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MCB_SESSION_SECRET=
MCB_SESSION_HOURS=12
# false only for plain-http local development
MCB_COOKIE_SECURE=true

# Only needed if the frontend is served from a different origin than the API
MCB_CORS_ORIGINS=

# Single organisations to leave out everywhere, as DBName:OrganisationID (MCB's own demo / internal ones).
MCB_EXCLUDE_ORGS=
# Count the month still in progress as well (default false).
MCB_INCLUDE_CURRENT_MONTH=false
