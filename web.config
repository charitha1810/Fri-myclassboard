<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <add name="httpplatformhandler" path="*" verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="C:\inetpub\wwwroot\fri.myclassboard.com\fri.myclassboard.com\backend\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 30 --log-level info --no-server-header"
                  startupTimeLimit="120"
                  requestTimeout="00:05:00"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\wwwroot\fri.myclassboard.com\logs\uvicorn.log">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\fri.myclassboard.com\fri.myclassboard.com\backend" />
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />

        <!-- Live overrides; everything else (DB, PostgreSQL, AI key, session secret) comes from backend\.env -->
        <!-- This server has ODBC Driver 17 only; backend\.env names Driver 18 -->
        <environmentVariable name="MCB_DB_DRIVER" value="ODBC Driver 17 for SQL Server" />
        <environmentVariable name="MCB_COOKIE_SECURE" value="true" />
      </environmentVariables>
    </httpPlatform>

    <!-- HTTPS redirect: keep non-localhost HTTP requests on HTTPS -->
    <rewrite>
      <rules>
        <rule name="HTTPSRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security and cache headers are set by the app itself -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- App source (with backend\.env) and logs live under this site's folder: never serve them -->
        <hiddenSegments>
          <add segment="fri.myclassboard.com" />
          <add segment="logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
